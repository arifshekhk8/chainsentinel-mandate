# Copy to .env locally. Never paste real credentials into chat or commit .env.
# Select gemini or groq explicitly for their free plans. No automatic provider fallback.
AI_PROVIDER=
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash. Check free quota in AI Studio; no paid-model fallback.
GEMINI_MODEL=
GROQ_API_KEY=
# Defaults to openai/gpt-oss-120b on Groq; keep your account on the Free plan.
GROQ_MODEL=
OPENAI_API_KEY=
# Choose a model available to your API project that supports Structured Outputs.
OPENAI_MODEL=
# Optional HTTPS Sepolia RPC. Defaults to PublicNode; never copied into browser state/evidence.
SEPOLIA_RPC_URL=
