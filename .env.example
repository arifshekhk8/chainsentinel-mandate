# Copy to .env locally. Never paste real credentials into chat or commit .env.
# Select gemini for the free-tier model; openai retains the original optional adapter.
AI_PROVIDER=
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash. Check free quota in AI Studio; no paid-model fallback.
GEMINI_MODEL=
OPENAI_API_KEY=
# Choose a model available to your API project that supports Structured Outputs.
OPENAI_MODEL=
